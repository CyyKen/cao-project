generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  id           BigInt   @id
  actor_type   String
  actor_id     Int
  action       String   @db.VarChar(100)
  target_table String?  @db.VarChar(100)
  target_id    Int?
  description  String?
  ip_address   String?  @db.VarChar(45)
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

model admins {
  id             Int       @id
  full_name      String    @db.VarChar(150)
  email          String    @db.VarChar(150)
  password_hash  String    @db.VarChar(255)
  is_active      Boolean   @default(true)
  is_super_admin Boolean   @default(false)
  role           String    @default("admin")
  last_login_at  DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
}

model announcement_scholars {
  id              Int      @id
  announcement_id Int
  scholar_id      Int
  created_at      DateTime @default(now()) @db.Timestamp(6)
}

model announcements {
  id         Int      @id
  title      String   @db.VarChar(255)
  body       String
  is_active  Boolean  @default(true)
  created_by Int?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model applicants {
  id             Int       @id
  id_number      String?   @db.VarChar(30)
  entry_date     DateTime? @db.Date
  first_name     String    @db.VarChar(100)
  middle_name    String?   @db.VarChar(100)
  last_name      String    @db.VarChar(100)
  name_ext       String?   @db.VarChar(10)
  email          String    @db.VarChar(150)
  phone          String?   @db.VarChar(20)
  street         String?   @db.VarChar(255)
  barangay       String?   @db.VarChar(100)
  municipality   String?   @db.VarChar(100)
  school_id      Int?
  gender         String?   @db.VarChar(30)
  date_of_birth  DateTime? @db.Date
  birthplace     String?   @db.VarChar(255)
  civil_status   String?   @default("Single")
  family_income  String?   @db.VarChar(20)
  gwa            Decimal?  @db.Decimal(3, 2)
  entry_method   String?   @db.VarChar(50)
  guardians      String?
  siblings_boys  Int       @default(0)
  siblings_girls Int       @default(0)
  status         String    @default("pending")
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  school_year    String?   @default("2025-2026") @db.VarChar(20)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  deleted_at     DateTime? @db.Timestamp(6)
}

model billing_official_lists {
  id           Int      @id
  school_year  String   @db.VarChar(20)
  semester     String
  applicant_id Int
  added_by     Int?
  added_at     DateTime @default(now()) @db.Timestamp(6)
  notes        String?
}

model billing_periods {
  id            Int       @id
  label         String    @db.VarChar(100)
  batch_number  String?   @db.VarChar(30)
  school_year   String    @db.VarChar(20)
  semester      String
  date_prepared DateTime? @db.Date
  is_active     Boolean   @default(false)
  remarks       String?
  created_by    Int?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
}

model billing_sessions {
  id                Int       @id
  batch_number      String    @db.VarChar(50)
  billing_period_id Int
  admin_id          Int
  scholar_count     Int       @default(0)
  total_amount      Decimal   @default(0.00) @db.Decimal(12, 2)
  status            String    @default("finalized")
  remarks           String?
  date_prepared     DateTime? @db.Date
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)
}

model billing_statement_scholars {
  id                   Int       @id
  billing_statement_id Int
  applicant_id         Int
  amount               Decimal?  @db.Decimal(10, 2)
  allowance            Decimal?  @db.Decimal(10, 2)
  paid_amount          Decimal?  @db.Decimal(10, 2)
  payroll_amount       Decimal?  @db.Decimal(10, 2)
  tuition_fee          Decimal?  @db.Decimal(10, 2)
  billing_status       String    @default("not_yet_billed")
  date_billed          DateTime? @db.Timestamp(6)
  billing_reference    String?   @db.VarChar(50)
  is_eligible          Boolean   @default(true)
  eligibility_notes    String?   @db.VarChar(255)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
}

model billing_statements {
  id                Int       @id
  billing_period_id Int
  school_id         Int
  submitted_at      DateTime? @db.Timestamp(6)
  received_by       Int?
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)
}

model control_accounts {
  id             Int       @id
  applicant_id   Int
  control_number String    @db.VarChar(20)
  username       String    @db.VarChar(100)
  password_hash  String    @db.VarChar(255)
  is_active      Boolean   @default(true)
  last_login_at  DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
}

model disbursements {
  id                    Int      @id
  payroll_claim_id      Int
  applicant_id          Int
  payroll_batch_id      Int
  disbursement_date     DateTime @db.Date
  amount_paid           Decimal  @db.Decimal(10, 2)
  payment_method        String   @default("check")
  transaction_reference String?  @db.VarChar(100)
  recipient_name        String?  @db.VarChar(150)
  processed_by          Int?
  remarks               String?
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @default(now()) @db.Timestamp(6)
}

model document_scans {
  id              Int       @id
  applicant_id    Int
  image_path      String    @db.VarChar(255)
  extracted_id    String?   @db.VarChar(50)
  expected_id     String?   @db.VarChar(50)
  confidence      Int       @default(0)
  verified        Boolean   @default(false)
  flagged         Boolean   @default(false)
  message         String?   @db.VarChar(500)
  raw_text        String?
  anti_spoof_data String?
  reviewed_by     Int?
  reviewed_at     DateTime? @db.Timestamp(6)
  review_notes    String?   @db.VarChar(500)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
}

model exam_slots {
  id           Int       @id
  applicant_id Int
  exam_id      Int
  appeared     Boolean?
  appeared_at  DateTime? @db.Timestamp(6)
  forfeited_at DateTime? @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)
}

model exams {
  id            Int      @id
  created_by    Int
  title         String   @db.VarChar(200)
  exam_date     DateTime @db.Timestamp(6)
  venue         String?  @db.VarChar(255)
  municipality  String?  @db.VarChar(100)
  academic_year String?  @db.VarChar(20)
  instructions  String?
  is_active     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
}

model obr_records {
  id                     Int       @id
  billing_period_id      Int
  obr_number             String?   @db.VarChar(50)
  status                 String    @default("eligibility_check")
  eligibility_checked_at DateTime? @db.Timestamp(6)
  names_verified_at      DateTime? @db.Timestamp(6)
  obr_prepared_at        DateTime? @db.Timestamp(6)
  names_certified_at     DateTime? @db.Timestamp(6)
  consolidated_at        DateTime? @db.Timestamp(6)
  submitted_to_budget_at DateTime? @db.Timestamp(6)
  prepared_by            Int?
  certified_by           Int?
  notes                  String?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @default(now()) @db.Timestamp(6)
}

model password_resets {
  id         Int       @id
  account_id Int
  token_hash String    @db.VarChar(64)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model payroll_batches {
  id                Int       @id
  batch_number      String    @db.VarChar(50)
  billing_period_id Int
  school_id         Int?
  total_scholars    Int       @default(0)
  total_amount      Decimal   @default(0.00) @db.Decimal(12, 2)
  status            String    @default("draft")
  prepared_by       Int?
  approved_by       Int?
  released_by       Int?
  prepared_at       DateTime  @default(now()) @db.Timestamp(6)
  approved_at       DateTime? @db.Timestamp(6)
  released_at       DateTime? @db.Timestamp(6)
  remarks           String?
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)
}

model payroll_claims {
  id                           Int       @id
  payroll_batch_id             Int
  applicant_id                 Int
  billing_statement_scholar_id Int?
  claim_amount                 Decimal   @db.Decimal(10, 2)
  claim_status                 String    @default("pending")
  rejection_reason             String?
  notes                        String?
  created_at                   DateTime  @default(now()) @db.Timestamp(6)
  updated_at                   DateTime  @default(now()) @db.Timestamp(6)
  claimed_date                 DateTime? @db.Timestamp(6)
  claimed_notes                String?
}

model results {
  id            Int      @id
  exam_slot_id  Int
  applicant_id  Int
  exam_id       Int
  score         Decimal? @db.Decimal(6, 2)
  passing_score Decimal? @db.Decimal(6, 2)
  passed        Boolean
  remarks       String?
  recorded_by   Int?
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
}

model scholar_accounts {
  id           Int      @id
  applicant_id Int
  result_id    Int?
  scholar_id   String?  @db.VarChar(30)
  issued_at    DateTime @default(now()) @db.Timestamp(6)
  issued_by    Int?
  is_active    Boolean  @default(true)
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
}

model scholar_requirements {
  id                                Int       @id
  applicant_id                      Int
  billing_period_id                 Int
  school_id                         Int?
  year_level                        String?   @db.VarChar(20)
  course                            String?   @db.VarChar(150)
  major                             String?   @db.VarChar(150)
  cert_of_registration              Boolean   @default(false)
  cor_file                          String?   @db.VarChar(255)
  cor_uploaded_at                   DateTime? @db.Timestamp(6)
  cor_review_status                 String?   @default("pending")
  cor_admin_comment                 String?
  cert_tax_exemption_file           String?   @db.VarChar(255)
  cert_tax_exemption_uploaded_at    DateTime? @db.Timestamp(6)
  cert_tax_exemption_review_status  String?   @default("pending")
  cert_tax_exemption_admin_comment  String?
  barangay_indigency_file           String?   @db.VarChar(255)
  barangay_indigency_uploaded_at    DateTime? @db.Timestamp(6)
  barangay_indigency_review_status  String?   @default("pending")
  barangay_indigency_admin_comment  String?
  valid_id_photocopy_file           String?   @db.VarChar(255)
  valid_id_photocopy_uploaded_at    DateTime? @db.Timestamp(6)
  valid_id_photocopy_review_status  String?   @default("pending")
  valid_id_photocopy_admin_comment  String?
  registration_form_file            String?   @db.VarChar(255)
  registration_form_uploaded_at     DateTime? @db.Timestamp(6)
  registration_form_review_status   String?   @default("pending")
  registration_form_admin_comment   String?
  tuition_fee_receipt_file          String?   @db.VarChar(255)
  tuition_fee_receipt_uploaded_at   DateTime? @db.Timestamp(6)
  tuition_fee_receipt_review_status String?   @default("pending")
  tuition_fee_receipt_admin_comment String?
  folder_physical_submitted         Boolean   @default(false)
  folder_physical_submitted_at      DateTime? @db.Timestamp(6)
  grade_report_card                 Boolean   @default(false)
  grade_report_file                 String?   @db.VarChar(255)
  grade_report_uploaded_at          DateTime? @db.Timestamp(6)
  grade_report_review_status        String?   @default("pending")
  grade_report_admin_comment        String?
  enrollment_form                   Boolean   @default(false)
  enrollment_form_file              String?   @db.VarChar(255)
  enrollment_form_uploaded_at       DateTime? @db.Timestamp(6)
  enrollment_form_review_status     String?   @default("pending")
  enrollment_form_admin_comment     String?
  cert_printed                      Boolean   @default(false)
  cert_printed_at                   DateTime? @db.Timestamp(6)
  cert_signed                       Boolean   @default(false)
  cert_signed_at                    DateTime? @db.Timestamp(6)
  submitted_to_school               Boolean   @default(false)
  submitted_to_school_at            DateTime? @db.Timestamp(6)
  updated_by                        Int?
  created_at                        DateTime  @default(now()) @db.Timestamp(6)
  updated_at                        DateTime  @default(now()) @db.Timestamp(6)
}

model schools {
  id             Int      @id
  name           String   @db.VarChar(255)
  school_type    String   @default("public")
  address        String?  @db.VarChar(255)
  contact_person String?  @db.VarChar(150)
  contact_email  String?  @db.VarChar(150)
  contact_phone  String?  @db.VarChar(20)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @db.Timestamp(6)
}

model staff {
  id            Int       @id
  full_name     String    @db.VarChar(150)
  email         String    @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  position      String    @default("Staff") @db.VarChar(100)
  department    String?   @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  is_active     Boolean   @default(true)
  last_login_at DateTime? @db.Timestamp(6)
  created_by    Int       @default(1)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
}

model system_settings {
  id            Int      @id
  setting_key   String   @db.VarChar(100)
  setting_value String   @default("") @db.VarChar(255)
  description   String?  @db.VarChar(255)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
}
